# ==============================================================================
# ENSAM IIoT Pipeline Environment Configuration
# ==============================================================================

# Project Name & Environment
PROJECT_NAME=ensam-iiot-pipeline
ENVIRONMENT=development
LOG_LEVEL=INFO

# MQTT Broker Settings
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_ID_SIMULATOR=ensam_sim_producer
MQTT_CLIENT_ID_EDGE=ensam_edge_consumer
MQTT_CLIENT_ID_DASHBOARD=ensam_scada_web
MQTT_TOPIC_PREFIX=ensam/iiot

# InfluxDB Time-Series Database Settings
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=ensam
INFLUXDB_BUCKET=iiot_telemetry
INFLUXDB_BUCKET_AGGREGATES=iiot_aggregates
INFLUXDB_ADMIN_USER=ensam_admin
INFLUXDB_ADMIN_PASSWORD=ensam_industrie40_password
INFLUXDB_ADMIN_TOKEN=ensam_iiot_super_secret_auth_token_2026_2027

# Next.js Dashboard
PORT=3000
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001
NEXT_PUBLIC_INFLUXDB_URL=http://localhost:8086
NEXT_PUBLIC_INFLUXDB_ORG=ensam
NEXT_PUBLIC_INFLUXDB_BUCKET=iiot_telemetry
NEXT_PUBLIC_INFLUXDB_TOKEN=ensam_iiot_super_secret_auth_token_2026_2027

# Simulator & Edge Tunables
SIMULATOR_NUM_DEVICES=5
SIMULATOR_FREQUENCY_HZ=1.0
SIMULATOR_RANDOM_SEED=42
EDGE_WINDOW_SIZE_SEC=10

